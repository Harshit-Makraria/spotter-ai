# Copy to backend/.env for local development.

DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Leave blank to use SQLite locally.
DATABASE_URL=

# Where the React app runs, so CORS lets it through.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Free key from https://openrouteservice.org/dev/#/signup
# Optional: without it the app falls back to the keyless OSRM demo server.
ORS_API_KEY=

GEO_USER_AGENT=eld-trip-planner/1.0 (assessment project)
